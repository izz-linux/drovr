# macOS signing and notarization settings for `scripts/build-signed.sh`.
#
# Copy this file to `.env.signing` (which is git-ignored) and fill in the values
# from your App Store Connect API key. See docs/signing.md for how to create one.
#
# Do NOT commit the real .env.signing or your .p8 key.

# The Developer ID certificate to sign with, exactly as
# `security find-identity -v -p codesigning` lists it. Tauri reads this
# variable; it isn't in tauri.conf.json so that builds without it (other
# machines, CI) still work, unsigned.
export APPLE_SIGNING_IDENTITY="Developer ID Application: Your Name (TEAMID1234)"

# Issuer ID (a UUID) from App Store Connect → Users and Access → Integrations → App Store Connect API.
export APPLE_API_ISSUER="00000000-0000-0000-0000-000000000000"

# Key ID (10 characters) of the API key you generated.
export APPLE_API_KEY="XXXXXXXXXX"

# Absolute path to the downloaded AuthKey_<KEYID>.p8 file.
# Apple lets you download it only once — store it somewhere safe outside the repo.
export APPLE_API_KEY_PATH="$HOME/.appstoreconnect/private_keys/AuthKey_XXXXXXXXXX.p8"
